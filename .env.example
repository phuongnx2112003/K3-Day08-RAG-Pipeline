# OpenAI-compatible LLM. Keep the default base URL for the official OpenAI API;
# change only OPENAI_BASE_URL if your organisation uses a compatible gateway.
OPENAI_API_KEY=sk-proj-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Gemini API Key (Tùy chọn - fallback nếu OpenRouter và OpenAI đều không có/hết quota)
# GEMINI_API_KEY=...

# PageIndex API Key (Tùy chọn - dùng cho Task 8: Vectorless RAG fallback)
# PAGEINDEX_API_KEY=pix_...

# Jina cloud embeddings + optional Jina reranking.
# JINA_API_KEY=jina_...
JINA_EMBEDDING_BASE_URL=https://api.jina.ai/v1/embeddings
JINA_EMBEDDING_MODEL=jina-embeddings-v3
JINA_EMBEDDING_DIM=1024
